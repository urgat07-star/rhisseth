[Unit]
Description=Rhisseth map API
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=rhisseth
Group=rhisseth
WorkingDirectory=/opt/rhisseth/repository/app/backend
EnvironmentFile=/opt/rhisseth/secrets/app.env
ExecStart=/opt/rhisseth/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8080 --workers 2 --limit-concurrency 32
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
MemoryMax=300M
CPUQuota=100%
TasksMax=64

[Install]
WantedBy=multi-user.target
